o default?":["\u0421\u0431\u0440\u043e\u0441\u0438\u0442\u044c \u043c\u0430\u043a\u0435\u0442 \u0434\u043e \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e?"],"Before you go \u2014 is the new Stats ready to replace the old one?":["\u041f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u0443\u0439\u0442\u0438, \u0441\u043a\u0430\u0436\u0438\u0442\u0435: \u0433\u043e\u0442\u043e\u0432\u0430 \u043b\u0438 \u043d\u043e\u0432\u0430\u044f \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u0437\u0430\u043c\u0435\u043d\u0438\u0442\u044c \u0441\u0442\u0430\u0440\u0443\u044e?"],"You'll go back to your current Stats. You can switch the new Stats on again from the Modules Visibility setting.":["\u0412\u044b \u0432\u0435\u0440\u043d\u0451\u0442\u0435\u0441\u044c \u043a \u0442\u0435\u043a\u0443\u0449\u0435\u0439 \u0432\u0435\u0440\u0441\u0438\u0438 \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0438. \u0412\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u0441\u043d\u043e\u0432\u0430 \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u043d\u043e\u0432\u0443\u044e \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443 \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445 \u0432\u0438\u0434\u0438\u043c\u043e\u0441\u0442\u0438 \u043c\u043e\u0434\u0443\u043b\u0435\u0439."],"Switch off the new Stats?":["\u041e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u043d\u043e\u0432\u0443\u044e \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0443?"],"It'll help us decide what to fix before the new Stats replaces the old one. You can send more any time from the page options menu.":["\u042d\u0442\u043e \u043f\u043e\u043c\u043e\u0436\u0435\u0442 \u043d\u0430\u043c \u043f\u043e\u043d\u044f\u0442\u044c, \u0447\u0442\u043e \u043d\u0443\u0436\u043d\u043e \u0438\u0441\u043f\u0440\u0430\u0432\u0438\u0442\u044c, \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u043d\u043e\u0432\u0430\u044f \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u0437\u0430\u043c\u0435\u043d\u0438\u0442 \u0441\u0442\u0430\u0440\u0443\u044e. \u0412\u044b \u043c\u043e\u0436\u0435\u0442\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0435\u0449\u0451 \u043e\u0434\u0438\u043d \u043e\u0442\u0437\u044b\u0432 \u0432 \u043b\u044e\u0431\u043e\u0435 \u0432\u0440\u0435\u043c\u044f \u0447\u0435\u0440\u0435\u0437 \u043c\u0435\u043d\u044e \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b."],"Thanks, your feedback has gone to the team.":["\u0421\u043f\u0430\u0441\u0438\u0431\u043e, \u0432\u0430\u0448 \u043e\u0442\u0437\u044b\u0432 \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u0435\u043d \u043a\u043e\u043c\u0430\u043d\u0434\u0435."],"What's missing?":["\u0427\u0435\u0433\u043e \u043d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442?"],"Any other feedback you'd like to share?":["\u0425\u043e\u0442\u0438\u0442\u0435 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c \u0434\u0440\u0443\u0433\u043e\u0439 \u043e\u0442\u0437\u044b\u0432?"],"Is the new Stats ready to replace the old one?":["\u0413\u043e\u0442\u043e\u0432\u0430 \u043b\u0438 \u043d\u043e\u0432\u0430\u044f \u0441\u0442\u0430\u0442\u0438\u0441\u0442\u0438\u043a\u0430 \u0437\u0430\u043c\u0435\u043d\u0438\u0442\u044c \u0441\u0442\u0430\u0440\u0443\u044e?"],"Not yet":["\u0415\u0449\u0451 \u043d\u0435\u0442"],"Almost \u2014 there are a few things missing":["\u041f\u043e\u0447\u0442\u0438 \u2014 \u0447\u0435\u0433\u043e-\u0442\u043e \u043d\u0435 \u0445\u0432\u0430\u0442\u0430\u0435\u0442"],"Yes, I'd be happy to switch now":["\u0414\u0430, \u044f \u0441 \u0440\u0430\u0434\u043e\u0441\u0442\u044c\u044e \u043f\u0435\u0440\u0435\u0439\u0434\u0443 \u043d\u0430 \u043d\u043e\u0432\u0443\u044e \u0432\u043a\u043b\u0430\u0434\u043a\u0443"],"We couldn\u2019t find any results.":["\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043d\u0430\u0439\u0442\u0438 \u043d\u0438 \u043e\u0434\u043d\u043e\u0433\u043e \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430."],"No data found":["\u0414\u0430\u043d\u043d\u044b\u0435 \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u044b"],"Hide map":["\u0421\u043a\u0440\u044b\u0442\u044c \u043a\u0430\u0440\u0442\u0443"],"Views shaded by country, with each city as a dot on the Cities tab. Pick a country on the Regions tab to see its regions instead.":["\u0418\u043d\u0442\u0435\u043d\u0441\u0438\u0432\u043d\u043e\u0441\u0442\u044c \u0446\u0432\u0435\u0442\u0430 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u0430 \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u043e\u0432 \u0432 \u0441\u0442\u0440\u0430\u043d\u0435, \u0430 \u043a\u0430\u0436\u0434\u044b\u0439 \u0433\u043e\u0440\u043e\u0434 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0430\u0435\u0442\u0441\u044f \u0442\u043e\u0447\u043a\u043e\u0439 \u043d\u0430 \u0432\u043a\u043b\u0430\u0434\u043a\u0435 \u00ab\u0413\u043e\u0440\u043e\u0434\u0430\u00bb. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0441\u0442\u0440\u0430\u043d\u0443 \u043d\u0430 \u0432\u043a\u043b\u0430\u0434\u043a\u0435 \u00ab\u0420\u0435\u0433\u0438\u043e\u043d\u044b\u00bb, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0435\u0451 \u0440\u0435\u0433\u0438\u043e\u043d\u044b."],"Views by location":["\u041f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u044b \u043f\u043e \u043c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044e"],"About %s":["\u041e %s"],"month and year\u0004%1$s %2$s":["%1$s %2$s"],"Totals":["\u0418\u0442\u043e\u0433\u043e"],"heatmap tooltip: date and count\u0004%1$s \u00b7 %2$s":["%1$s \u00b7 %2$s"],"More views":["\u0411\u043e\u043b\u044c\u0448\u0435 \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u043e\u0432"],"Fewer views":["\u041c\u0435\u043d\u044c\u0448\u0435 \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u043e\u0432"],"More views per day":["\u0411\u043e\u043b\u044c\u0448\u0435 \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u043e\u0432 \u0432 \u0434\u0435\u043d\u044c"],"Fewer views per day":["\u041c\u0435\u043d\u044c\u0448\u0435 \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u043e\u0432 \u0432 \u0434\u0435\u043d\u044c"],"We couldn\u2019t find results for this time period.":["\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043d\u0430\u0439\u0442\u0438 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u044b \u0437\u0430 \u044d\u0442\u043e\u0442 \u043f\u0435\u0440\u0438\u043e\u0434."],"Same period last year (match day of week)":["\u0422\u043e\u0442 \u0436\u0435 \u043f\u0435\u0440\u0438\u043e\u0434 \u043f\u0440\u043e\u0448\u043b\u043e\u0433\u043e \u0433\u043e\u0434\u0430 (\u0441 \u0443\u0447\u0451\u0442\u043e\u043c \u0434\u043d\u044f \u043d\u0435\u0434\u0435\u043b\u0438)"],"weekday-aligned comparison\u0004%s (match day of week)":["%s (\u0441 \u0443\u0447\u0451\u0442\u043e\u043c \u0434\u043d\u044f \u043d\u0435\u0434\u0435\u043b\u0438)"],"short comparison preset\u0004Prev. year (weekday)":["\u041f\u0440\u0435\u0434. \u0433\u043e\u0434 (\u043f\u043e \u0434\u043d\u044f\u043c \u043d\u0435\u0434\u0435\u043b\u0438)"],"short comparison preset\u0004Prev. period (weekday)":["\u041f\u0440\u0435\u0434. \u043f\u0435\u0440\u0438\u043e\u0434 (\u043f\u043e \u0434\u043d\u044f\u043c \u043d\u0435\u0434\u0435\u043b\u0438)"],"No views":["\u041d\u0435\u0442 \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u043e\u0432"],"\u2026and %d more location":["\u2026\u0438 \u0435\u0449\u0451 %d \u043c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u0435","\u2026\u0438 \u0435\u0449\u0451 \u043c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f (%d)","\u2026\u0438 \u0435\u0449\u0451 \u043c\u0435\u0441\u0442\u043e\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f (%d)"],"Avg images per post":["\u0421\u0440. \u043a\u043e\u043